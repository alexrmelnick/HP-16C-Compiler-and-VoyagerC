; https://www.hpmuseum.org/cgi-sys/cgiwrap/hpmuseum/archv018.cgi?read=138626

; Instructions:
; GSB float_to_int
; GSB int_to_float
; GSB truncate
; GSB round_number



store_sign:
    CF 2	
    x<0	
        SF 2	
    ABS	
    RTN	

round_for_truncation:
    EEX	
    9	
    +	
    LSTx	
    -	
    RTN	

float_to_int:
    GSB store_sign
    HEX     ; Convert
    ABS
    STO I	
    x<>y	
    shift_mantissa:
        ASR	
        DSZ	
        GTO shift_mantissa
    0	    ; Set wordsize to 64
    WSIZE	
    SF 3	
    restore_sign:
    F? 2    ; Restore sign
        CHS	
    SF 3	; Show leading zeroes
    RTN	

truncate:
    GSB store_sign
	ENTER
	ENTER	
    GSB round_for_truncation
    x>y     ; Adjust rounded result by 1
    	1
	0	
    Enter	
    10	
    /	
    -
    RTN	

round_number:
    GSB store_sign
    GSB round_for_truncation
    GTO restore_sign

int_to_float:
    0	
    FLOAT 4     ; Number of decimal places
    RTN	

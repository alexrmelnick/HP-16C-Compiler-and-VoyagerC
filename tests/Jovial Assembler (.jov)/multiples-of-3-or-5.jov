// Project Euler problem 1
// If we list all the natural numbers below 10 that are multiples of 3 or 5, we get 3, 5, 6 and 9. The sum of these multiples is 23.
// Find the sum of all the multiples of 3 or 5 below 1000.

// Answer: 233,168

//  let sum = 0
//  for (let i = 999; i > 0; i--)
//      if (i % 3 == 0) 
//          sum += i
//      else if (i % 5 == 0) 
//          sum += i
//  sum

// Memory Map:
// RI := Counter
// R0 := sum
// Default settings: Unsigned, 32-bit, dec
main:   // Start of program
    UNSGN
    DEC
    32
    WSIZE

    999     // X <- 999 := i_start
    sto i   // RI <- X==999 := i_start
    0       // R0 <- 0 := sum
    sto 0   

    divisor_loop:   // Loop top
        rcl i   // X <- RI
        3       // X <- 3, Y <- RI
        rmd     // X <- RI % 3
        x==0    // If X==0, goto 1, else skip
            gto add_counter
        rcl I   // Else if I%5 == 0
        5
        rmd
        x==0
            gto add_counter
        
        continue_loop:   // END IF
        dsz     // RI--, do next instruction if RI==0
            gto divisor_loop   // Goto top of loop
        gto done

    done:   // End of program
    rcl 0
    show dec // display result
    rtn

add_counter:   // sum += I
    rcl 0
    rcl i
    +
    sto 0
    gto continue_loop
